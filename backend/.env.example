MONGO_URI=mongodb://localhost:27017
MONGO_DB=earthscape
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60
HDFS_NAMENODE_HOST=localhost
HDFS_WEBHDFS_PORT=9870
# Set to empty string when HDFS DataNode is on a remote cluster (no host rewrite)
HDFS_DATANODE_REWRITE_HOST=localhost
YARN_RM_PORT=8088
HADOOP_STREAMING_JAR=/usr/local/hadoop/share/hadoop/tools/lib/hadoop-streaming-3.3.6.jar
CORS_ORIGINS=http://localhost:5173
ALERT_CACHE_TTL_SECONDS=60
REALTIME_PRODUCER_INTERVAL=10
DEFAULT_ADMIN_EMAIL=admin@earthscape.com
DEFAULT_ADMIN_PASSWORD=Admin123!
ARCHIVE_THRESHOLD_DAYS=365
MAPREDUCE_DEFAULT_FILL=-9999